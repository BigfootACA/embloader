#!/bin/sh
set -e

PACKAGE="sdboot-is-embloader"

get_embloader_version() {
    LOADER_INFO=$(LC_ALL=C grep -aom1 '#### LoaderInfo: [^#]* ####' "$1" 2>/dev/null) || return 1
    case "$LOADER_INFO" in
        "#### LoaderInfo: systemd 999."*" (embloader "*") ####")
            LOADER_INFO=${LOADER_INFO#*" (embloader "}
            LOADER_INFO=${LOADER_INFO%") ####"}
            [ -n "$LOADER_INFO" ] || return 1
            printf '%s\n' "$LOADER_INFO"
            ;;
        *)
            return 1
            ;;
    esac
}

case "$1" in
    configure)
        ARCH=$(dpkg --print-architecture)
        case "$ARCH" in
            amd64)
                SDBOOT_EFI="systemd-bootx64.efi"
                ;;
            arm64)
                SDBOOT_EFI="systemd-bootaa64.efi"
                ;;
            i386)
                SDBOOT_EFI="systemd-bootia32.efi"
                ;;
            riscv64)
                SDBOOT_EFI="systemd-bootriscv64.efi"
                ;;
            *)
                echo "Unsupported architecture: $ARCH" >&2
                exit 1
                ;;
        esac

        for SDBOOT_PATH in "/usr/lib/systemd/boot/efi/$SDBOOT_EFI" "/usr/lib/systemd/boot/efi/$SDBOOT_EFI.signed"; do
            if ! dpkg-divert --list "$SDBOOT_PATH" | grep -q "$PACKAGE"; then
                if [ -f "$SDBOOT_PATH" ] || [ -L "$SDBOOT_PATH" ]; then
                    dpkg-divert --package "$PACKAGE" --divert "${SDBOOT_PATH}.distrib" \
                        --rename "$SDBOOT_PATH"
                fi
            fi

            cp /usr/share/embloader/embloader.efi "$SDBOOT_PATH"
        done

        if command -v bootctl >/dev/null 2>&1; then
            ESP_PATH=$(bootctl --print-esp-path 2>/dev/null) || ESP_PATH=
            if [ -n "$ESP_PATH" ]; then
                INSTALLED_VERSION=$(get_embloader_version \
                    "$ESP_PATH/EFI/systemd/$SDBOOT_EFI") || INSTALLED_VERSION=
                AVAILABLE_VERSION=$(get_embloader_version \
                    /usr/share/embloader/embloader.efi) || AVAILABLE_VERSION=
                if [ -n "$INSTALLED_VERSION" ] && [ -n "$AVAILABLE_VERSION" ] && \
                        dpkg --compare-versions "$INSTALLED_VERSION" lt "$AVAILABLE_VERSION"; then
                    if ! bootctl --esp-path="$ESP_PATH" install; then
                        echo "Warning: failed to update embloader on the EFI System Partition" >&2
                    fi
                fi
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
