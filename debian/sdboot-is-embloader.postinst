#!/bin/sh
set -e

PACKAGE="sdboot-is-embloader"

get_loader_info() {
    LC_ALL=C grep -aom1 '#### LoaderInfo: [^#]* ####' "$1" 2>/dev/null
}

get_embloader_version() {
    LOADER_INFO=$(get_loader_info "$1") || return 1
    case "$LOADER_INFO" in
        "#### LoaderInfo: systemd 999."*" (embloader "*") ####")
            LOADER_INFO=${LOADER_INFO#*" (embloader "}
            LOADER_INFO=${LOADER_INFO%") ####"}
            [ -n "$LOADER_INFO" ] || return 1
            printf '%s\n' "$LOADER_INFO"
            ;;
        *)
            return 1
            ;;
    esac
}

is_systemd_boot() {
    LOADER_INFO=$(get_loader_info "$1") || return 1
    case "$LOADER_INFO" in
        "#### LoaderInfo: systemd-boot "*" ####")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

is_replaceable_loader() {
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        return 0
    fi
    get_embloader_version "$1" >/dev/null || is_systemd_boot "$1"
}

get_diversion_owner() {
    dpkg-divert --listpackage "$1"
}

validate_managed_path() {
    MANAGED_PATH=$1
    DIVERSION_OWNER=$(get_diversion_owner "$MANAGED_PATH")
    if [ -n "$DIVERSION_OWNER" ] && [ "$DIVERSION_OWNER" != "$PACKAGE" ]; then
        echo "Refusing to replace $MANAGED_PATH: diverted by $DIVERSION_OWNER" >&2
        return 1
    fi
    if [ "$DIVERSION_OWNER" = "$PACKAGE" ] && \
            { [ -e "$MANAGED_PATH" ] || [ -L "$MANAGED_PATH" ]; } && \
            ! get_embloader_version "$MANAGED_PATH" >/dev/null; then
        echo "Refusing to replace $MANAGED_PATH while its diversion target is occupied" >&2
        return 1
    fi
    if { [ -e "$MANAGED_PATH" ] || [ -L "$MANAGED_PATH" ]; } && \
            ! get_embloader_version "$MANAGED_PATH" >/dev/null && \
            ! is_systemd_boot "$MANAGED_PATH"; then
        echo "Refusing to replace unrecognized boot loader $MANAGED_PATH" >&2
        return 1
    fi
}

secure_boot_enabled() {
    for SECURE_BOOT_VAR in /sys/firmware/efi/efivars/SecureBoot-*; do
        [ -r "$SECURE_BOOT_VAR" ] || continue
        SECURE_BOOT_VALUE=$(od -An -tu1 -j4 -N1 "$SECURE_BOOT_VAR" 2>/dev/null) || continue
        [ "$SECURE_BOOT_VALUE" -eq 1 ] && return 0
        return 1
    done
    command -v bootctl >/dev/null 2>&1 || return 1
    LC_ALL=C bootctl status --no-pager 2>/dev/null | \
        grep -Eq '^[[:space:]]*Secure Boot:[[:space:]]+enabled'
}

divert_path() {
    DIVERSION_OWNER=$(get_diversion_owner "$1")
    if [ -z "$DIVERSION_OWNER" ]; then
        if get_embloader_version "$1" >/dev/null; then
            rm -f "$1"
        fi
        dpkg-divert --package "$PACKAGE" --divert "${1}.distrib" --rename "$1"
    fi
}

restore_managed_path() {
    MANAGED_PATH=$1
    DIVERSION_OWNER=$(get_diversion_owner "$MANAGED_PATH")
    if [ -e "$MANAGED_PATH" ] || [ -L "$MANAGED_PATH" ]; then
        if get_embloader_version "$MANAGED_PATH" >/dev/null; then
            rm -f "$MANAGED_PATH"
        elif [ "$DIVERSION_OWNER" = "$PACKAGE" ]; then
            echo "Refusing to restore $MANAGED_PATH over an existing boot loader" >&2
            return 1
        fi
    fi
    if [ "$DIVERSION_OWNER" = "$PACKAGE" ]; then
        dpkg-divert --package "$PACKAGE" --rename --remove "$MANAGED_PATH"
    fi
}

restore_esp_loader() {
    TARGET=$1
    SOURCE=$2
    if get_embloader_version "$TARGET" >/dev/null; then
        if [ -f "$SOURCE" ]; then
            install -Dm644 "$SOURCE" "$TARGET"
        else
            rm -f "$TARGET"
            echo "Warning: no systemd-boot binary is available to restore $TARGET" >&2
        fi
    fi
}

case "$1" in
    configure)
        ARCH=$(dpkg --print-architecture)
        case "$ARCH" in
            amd64)
                SDBOOT_EFI="systemd-bootx64.efi"
                BOOT_EFI="BOOTX64.EFI"
                ;;
            arm64)
                SDBOOT_EFI="systemd-bootaa64.efi"
                BOOT_EFI="BOOTAA64.EFI"
                ;;
            i386)
                SDBOOT_EFI="systemd-bootia32.efi"
                BOOT_EFI="BOOTIA32.EFI"
                ;;
            riscv64)
                SDBOOT_EFI="systemd-bootriscv64.efi"
                BOOT_EFI="BOOTRISCV64.EFI"
                ;;
            *)
                echo "Unsupported architecture: $ARCH" >&2
                exit 1
                ;;
        esac

        SDBOOT_PATH="/usr/lib/systemd/boot/efi/$SDBOOT_EFI"
        SIGNED_SDBOOT_PATH="${SDBOOT_PATH}.signed"
        validate_managed_path "$SDBOOT_PATH"
        validate_managed_path "$SIGNED_SDBOOT_PATH"

        if secure_boot_enabled; then
            restore_managed_path "$SDBOOT_PATH"
            restore_managed_path "$SIGNED_SDBOOT_PATH"
            if command -v bootctl >/dev/null 2>&1; then
                ESP_PATH=$(bootctl --print-esp-path 2>/dev/null) || ESP_PATH=
                if [ -n "$ESP_PATH" ]; then
                    RESTORE_SOURCE=
                    if is_systemd_boot "$SIGNED_SDBOOT_PATH"; then
                        RESTORE_SOURCE=$SIGNED_SDBOOT_PATH
                    elif is_systemd_boot "$SDBOOT_PATH"; then
                        RESTORE_SOURCE=$SDBOOT_PATH
                    fi
                    restore_esp_loader "$ESP_PATH/EFI/systemd/$SDBOOT_EFI" "$RESTORE_SOURCE"
                    restore_esp_loader "$ESP_PATH/EFI/BOOT/$BOOT_EFI" "$RESTORE_SOURCE"
                fi
            fi
            echo "Refusing to replace systemd-boot with an unsigned embloader while Secure Boot is enabled" >&2
            exit 1
        fi

        if ! get_embloader_version /usr/share/embloader/embloader.efi >/dev/null; then
            echo "Packaged embloader has no valid version metadata" >&2
            exit 1
        fi

        divert_path "$SIGNED_SDBOOT_PATH"
        if [ -e "$SIGNED_SDBOOT_PATH" ] || [ -L "$SIGNED_SDBOOT_PATH" ]; then
            rm -f "$SIGNED_SDBOOT_PATH"
        fi

        divert_path "$SDBOOT_PATH"
        install -m 0644 /usr/share/embloader/embloader.efi "$SDBOOT_PATH"

        if command -v bootctl >/dev/null 2>&1; then
            ESP_PATH=$(bootctl --print-esp-path 2>/dev/null) || ESP_PATH=
            if [ -n "$ESP_PATH" ]; then
                SYSTEMD_TARGET="$ESP_PATH/EFI/systemd/$SDBOOT_EFI"
                FALLBACK_TARGET="$ESP_PATH/EFI/BOOT/$BOOT_EFI"
                if ! is_replaceable_loader "$SYSTEMD_TARGET" || \
                        ! is_replaceable_loader "$FALLBACK_TARGET"; then
                    echo "Warning: refusing to overwrite an unrecognized boot loader on the EFI System Partition" >&2
                else
                    if ! bootctl --esp-path="$ESP_PATH" install; then
                        echo "Warning: failed to install embloader on the EFI System Partition" >&2
                    fi
                fi
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
